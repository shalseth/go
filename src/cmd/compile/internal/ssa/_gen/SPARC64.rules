// Lowering for linux/sparc64.
//
// SPARC V9 is a 64-bit big-endian RISC with a 13-bit signed immediate
// field. Sub-word arithmetic is done in 64-bit registers and narrowed
// on store or when the width matters, as on the other 64-bit RISC
// backends.

// Arithmetic.
(Add(64|32|16|8|Ptr) ...) => (ADD ...)
(Add(32|64)F ...) => (FADD(S|D) ...)

(Sub(64|32|16|8|Ptr) ...) => (SUB ...)
(Sub(32|64)F ...) => (FSUB(S|D) ...)

(Mul(64|32|16|8) ...) => (MULD ...)
(Mul(32|64)F ...) => (FMUL(S|D) ...)

(Div(32|64)F ...) => (FDIV(S|D) ...)
(Div64 [false] x y) => (SDIVD x y)
(Div64u x y) => (UDIVD x y)

(Neg(64|32|16|8) x) => (NEG x)
(Neg(32|64)F ...) => (FNEG(S|D) ...)

// Logical.
(And(64|32|16|8|B) ...) => (AND ...)
(Or(64|32|16|8|B) ...) => (OR ...)
(Xor(64|32|16|8) ...) => (XOR ...)
(Com(64|32|16|8) x) => (XNOR x (MOVDconst [0]))

// Shifts. Go defines shifts by counts >= width as producing zero, which
// SPARC does not, so those are handled by the generic rules that guard
// with a comparison; the bare lowerings below are the unguarded forms.

// Comparisons produce condition codes; the block rules below consume them.

// Constants.
(Const(64|32|16|8) [val]) => (MOVDconst [int64(val)])
(Const(32|64)F ...) => (FMOV(S|D)const ...)
(ConstNil) => (MOVDconst [0])
(ConstBool [t]) => (MOVDconst [b2i(t)])

// Addresses.
(Addr {sym} base) => (MOVDaddr {sym} base)
(LocalAddr <t> {sym} base mem) && t.Elem().HasPointers() => (MOVDaddr {sym} (SPanchored base mem))
(LocalAddr <t> {sym} base _) && !t.Elem().HasPointers() => (MOVDaddr {sym} base)
// An address derived from SP stays a MOVDaddr rather than becoming
// arithmetic on SP, matching what the other backends do: the compiler
// tracks stack-slot addresses through MOVDaddr.
(OffPtr [off] ptr:(SP)) && is32Bit(off) => (MOVDaddr [int32(off)] ptr)
(OffPtr [off] ptr) && is13Bit(off) => (ADDconst [off] ptr)
(OffPtr [off] ptr) => (ADD (MOVDconst [off]) ptr)

// Merge offset arithmetic back into the address, so that a field access is a
// single addressed operand rather than an add feeding a load. This is what
// lets the folds below fire on anything but the first field.
(ADDconst [c] (MOVDaddr [d] {sym} x)) && is32Bit(c+int64(d)) => (MOVDaddr [int32(c+int64(d))] {sym} x)

// Fold a named stack address into the memory operand, as the other backends
// do. Without this every field access materialises its own address, which
// costs an instruction and, worse, gives the address of a named result many
// uses that the scheduler may place before the result's VarDef. Taking an
// address counts as a read, so liveness then reports the result live at
// function entry and the compiler dies with "bad live variable at entry".
//
// Only addresses carrying a symbol are folded, and never through SB. A bare
// (MOVDaddr [off] SP) has Name NAME_NONE, and obj adds the 2047 stack bias
// only when rewriting NAME_AUTO and NAME_PARAM operands -- folding one of
// those would drop the bias and leave every access misaligned by an odd
// amount, which SPARC reports as a bus error rather than anything subtle.
(MOV(B|H|W|D)store [off1] {sym1} (MOVDaddr [off2] {sym2} ptr) val mem)
	&& canMergeSym(sym1, sym2) && sym2 != nil && ptr.Op != OpSB
	&& is32Bit(int64(off1)+int64(off2))
	=> (MOV(B|H|W|D)store [off1+off2] {mergeSym(sym1,sym2)} ptr val mem)

(FMOV(S|D)store [off1] {sym1} (MOVDaddr [off2] {sym2} ptr) val mem)
	&& canMergeSym(sym1, sym2) && sym2 != nil && ptr.Op != OpSB
	&& is32Bit(int64(off1)+int64(off2))
	=> (FMOV(S|D)store [off1+off2] {mergeSym(sym1,sym2)} ptr val mem)

(MOV(B|UB|H|UH|W|UW|D)load [off1] {sym1} (MOVDaddr [off2] {sym2} ptr) mem)
	&& canMergeSym(sym1, sym2) && sym2 != nil && ptr.Op != OpSB
	&& is32Bit(int64(off1)+int64(off2))
	=> (MOV(B|UB|H|UH|W|UW|D)load [off1+off2] {mergeSym(sym1,sym2)} ptr mem)

(FMOV(S|D)load [off1] {sym1} (MOVDaddr [off2] {sym2} ptr) mem)
	&& canMergeSym(sym1, sym2) && sym2 != nil && ptr.Op != OpSB
	&& is32Bit(int64(off1)+int64(off2))
	=> (FMOV(S|D)load [off1+off2] {mergeSym(sym1,sym2)} ptr mem)

// Loads.
(Load <t> ptr mem) && t.IsBoolean() => (MOVUBload ptr mem)
(Load <t> ptr mem) && is8BitInt(t) && t.IsSigned() => (MOVBload ptr mem)
(Load <t> ptr mem) && is8BitInt(t) && !t.IsSigned() => (MOVUBload ptr mem)
(Load <t> ptr mem) && is16BitInt(t) && t.IsSigned() => (MOVHload ptr mem)
(Load <t> ptr mem) && is16BitInt(t) && !t.IsSigned() => (MOVUHload ptr mem)
(Load <t> ptr mem) && is32BitInt(t) && t.IsSigned() => (MOVWload ptr mem)
(Load <t> ptr mem) && is32BitInt(t) && !t.IsSigned() => (MOVUWload ptr mem)
(Load <t> ptr mem) && (is64BitInt(t) || isPtr(t)) => (MOVDload ptr mem)
(Load <t> ptr mem) && is32BitFloat(t) => (FMOVSload ptr mem)
(Load <t> ptr mem) && is64BitFloat(t) => (FMOVDload ptr mem)

// Stores.
(Store {t} ptr val mem) && t.Size() == 1 => (MOVBstore ptr val mem)
(Store {t} ptr val mem) && t.Size() == 2 => (MOVHstore ptr val mem)
(Store {t} ptr val mem) && t.Size() == 4 && !t.IsFloat() => (MOVWstore ptr val mem)
(Store {t} ptr val mem) && t.Size() == 8 && !t.IsFloat() => (MOVDstore ptr val mem)
(Store {t} ptr val mem) && t.Size() == 4 && t.IsFloat() => (FMOVSstore ptr val mem)
(Store {t} ptr val mem) && t.Size() == 8 && t.IsFloat() => (FMOVDstore ptr val mem)

// Conversions.
(SignExt8to(16|32|64) ...) => (MOVB ...)
(SignExt16to(32|64) ...) => (MOVH ...)
(SignExt32to64 ...) => (MOVW ...)
(ZeroExt8to(16|32|64) ...) => (MOVUB ...)
(ZeroExt16to(32|64) ...) => (MOVUH ...)
(ZeroExt32to64 ...) => (MOVUW ...)
(Trunc(16|32|64)to8 ...) => (Copy ...)
(Trunc(32|64)to16 ...) => (Copy ...)
(Trunc64to32 ...) => (Copy ...)

(Cvt32Fto64F ...) => (FSTOD ...)
(Cvt64Fto32F ...) => (FDTOS ...)
(Cvt64to(32|64)F ...) => (FXTO(S|D) ...)
(Cvt(32|64)Fto64 ...) => (F(S|D)TOX ...)

// Calls.
(StaticCall ...) => (CALLstatic ...)
(ClosureCall ...) => (CALLclosure ...)
(InterCall ...) => (CALLinter ...)
(TailCall ...) => (CALLtail ...)

// Runtime support.
(GetClosurePtr ...) => (LoweredGetClosurePtr ...)
(GetCallerSP ...) => (LoweredGetCallerSP ...)
(GetCallerPC ...) => (LoweredGetCallerPC ...)
(IsNonNil ptr) => (NotEqual (CMPconst [0] ptr))
(IsInBounds idx len) => (LessThanU (CMP idx len))
(IsSliceInBounds idx len) => (LessEqualU (CMP idx len))
(NilCheck ...) => (LoweredNilCheck ...)
(PubBarrier ...) => (LoweredPubBarrier ...)

(PanicBounds ...) => (LoweredPanicBoundsRR ...)
(LoweredPanicBoundsRR [kind] x (MOVDconst [c]) mem) => (LoweredPanicBoundsRC [kind] x {PanicBoundsC{C:c}} mem)
(LoweredPanicBoundsRR [kind] (MOVDconst [c]) y mem) => (LoweredPanicBoundsCR [kind] {PanicBoundsC{C:c}} y mem)
(LoweredPanicBoundsRC [kind] {p} (MOVDconst [c]) mem) => (LoweredPanicBoundsCC [kind] {PanicBoundsCC{Cx:c, Cy:p.C}} mem)
(LoweredPanicBoundsCR [kind] {p} (MOVDconst [c]) mem) => (LoweredPanicBoundsCC [kind] {PanicBoundsCC{Cx:p.C, Cy:c}} mem)

// Zeroing. Small, aligned regions are stored inline; anything larger
// uses the LoweredZero loop.
(Zero [0] _ mem) => mem
(Zero [1] ptr mem) => (MOVBstore ptr (MOVDconst [0]) mem)
(Zero [2] {t} ptr mem) && t.Alignment()%2 == 0 => (MOVHstore ptr (MOVDconst [0]) mem)
(Zero [4] {t} ptr mem) && t.Alignment()%4 == 0 => (MOVWstore ptr (MOVDconst [0]) mem)
(Zero [8] {t} ptr mem) && t.Alignment()%8 == 0 => (MOVDstore ptr (MOVDconst [0]) mem)
// AuxInt packs the byte count and the access width: s<<4 | width. The
// width comes from the alignment; Go type sizes are multiples of their
// alignment, so the loop terminates exactly.
(Zero [s] {t} ptr mem) && t.Alignment()%8 == 0 => (LoweredZero [s<<4|8] ptr mem)
(Zero [s] {t} ptr mem) && t.Alignment()%4 == 0 => (LoweredZero [s<<4|4] ptr mem)
(Zero [s] {t} ptr mem) && t.Alignment()%2 == 0 => (LoweredZero [s<<4|2] ptr mem)
(Zero [s] ptr mem) => (LoweredZero [s<<4|1] ptr mem)

// Moves, likewise.
(Move [0] _ _ mem) => mem
(Move [1] dst src mem) => (MOVBstore dst (MOVBload src mem) mem)
(Move [2] {t} dst src mem) && t.Alignment()%2 == 0 => (MOVHstore dst (MOVHload src mem) mem)
(Move [4] {t} dst src mem) && t.Alignment()%4 == 0 => (MOVWstore dst (MOVWload src mem) mem)
(Move [8] {t} dst src mem) && t.Alignment()%8 == 0 => (MOVDstore dst (MOVDload src mem) mem)
(Move [s] {t} dst src mem) && t.Alignment()%8 == 0 => (LoweredMove [s<<4|8] dst src mem)
(Move [s] {t} dst src mem) && t.Alignment()%4 == 0 => (LoweredMove [s<<4|4] dst src mem)
(Move [s] {t} dst src mem) && t.Alignment()%2 == 0 => (LoweredMove [s<<4|2] dst src mem)
(Move [s] dst src mem) => (LoweredMove [s<<4|1] dst src mem)

// Write barrier.
(WB ...) => (LoweredWB ...)

// TODO(sparc64): atomics need a CASD retry loop; not lowered yet.

// Optimizations. Fold a constant into the immediate field when it fits
// SPARC's 13-bit signed range; otherwise leave it in a register.
(ADD (MOVDconst [c]) x) && is13Bit(c) => (ADDconst [c] x)
(SUB x (MOVDconst [c])) && is13Bit(c) => (SUBconst [c] x)
(AND (MOVDconst [c]) x) && is13Bit(c) => (ANDconst [c] x)
(OR  (MOVDconst [c]) x) && is13Bit(c) => (ORconst  [c] x)
(XOR (MOVDconst [c]) x) && is13Bit(c) => (XORconst [c] x)
(CMP x (MOVDconst [c])) && is13Bit(c) => (CMPconst [c] x)

// Fold a width conversion of a constant back into a constant. Without
// this the extends inserted by the sub-word comparison rules block the
// CMPconst fold above, and the write-barrier decision block ends up
// with a two-argument control value, which liveness rejects.
(MOVB  (MOVDconst [c])) => (MOVDconst [int64(int8(c))])
(MOVUB (MOVDconst [c])) => (MOVDconst [int64(uint8(c))])
(MOVH  (MOVDconst [c])) => (MOVDconst [int64(int16(c))])
(MOVUH (MOVDconst [c])) => (MOVDconst [int64(uint16(c))])
(MOVW  (MOVDconst [c])) => (MOVDconst [int64(int32(c))])
(MOVUW (MOVDconst [c])) => (MOVDconst [int64(uint32(c))])
(MOVD  (MOVDconst [c])) => (MOVDconst [c])

// Fold a comparison against a zero-extended 32-bit constant. This is
// the shape the write-barrier check compiles to, and liveness requires
// that decision block's control value to have a single argument.
//
// This fold once appeared to cause a liveness failure ("bad live
// variable at entry") in four packages, but was innocent: the real
// cause was the end-address operand the old LoweredZero/LoweredMove
// carried, which the scheduler could float above a result's VarDef.
// Changing which values fold merely shifted register pressure and moved
// the symptom around. See the LoweredZero comment in SPARC64Ops.go.
(CMP x (MOVUW (MOVDconst [c]))) && is13Bit(int64(uint32(c))) => (CMPconst [int64(uint32(c))] x)

(SLLD x (MOVDconst [c])) => (SLLDconst [c&63] x)
(SRLD x (MOVDconst [c])) => (SRLDconst [c&63] x)
(SRAD x (MOVDconst [c])) => (SRADconst [c&63] x)

(ADDconst [0] x) => x
(SUBconst [0] x) => x
(ANDconst [-1] x) => x
(ORconst [0] x) => x
(XORconst [0] x) => x

// Branch lowering.
(If (Equal cc) yes no) => (EQ cc yes no)
(If (NotEqual cc) yes no) => (NE cc yes no)
(If (LessThan cc) yes no) => (LT cc yes no)
(If (LessEqual cc) yes no) => (LE cc yes no)
(If (GreaterThan cc) yes no) => (GT cc yes no)
(If (GreaterEqual cc) yes no) => (GE cc yes no)
(If (LessThanU cc) yes no) => (ULT cc yes no)
(If (LessEqualU cc) yes no) => (ULE cc yes no)
(If (GreaterThanU cc) yes no) => (UGT cc yes no)
(If (GreaterEqualU cc) yes no) => (UGE cc yes no)

(If cond yes no) => (NE (CMPconst [0] cond) yes no)

// Comparisons. Sub-64-bit operands are widened first: signed types
// with a sign-extend, unsigned with a zero-extend, so the 64-bit
// compare sees the right ordering.
(Eq8 x y) => (Equal (CMP (ZeroExt8to64 x) (ZeroExt8to64 y)))
(Neq8 x y) => (NotEqual (CMP (ZeroExt8to64 x) (ZeroExt8to64 y)))
(Eq16 x y) => (Equal (CMP (ZeroExt16to64 x) (ZeroExt16to64 y)))
(Neq16 x y) => (NotEqual (CMP (ZeroExt16to64 x) (ZeroExt16to64 y)))
(Eq32 x y) => (Equal (CMP (ZeroExt32to64 x) (ZeroExt32to64 y)))
(Neq32 x y) => (NotEqual (CMP (ZeroExt32to64 x) (ZeroExt32to64 y)))
(EqB x y) => (Equal (CMP (ZeroExt8to64 x) (ZeroExt8to64 y)))
(NeqB x y) => (NotEqual (CMP (ZeroExt8to64 x) (ZeroExt8to64 y)))
(EqPtr x y) => (Equal (CMP x y))
(NeqPtr x y) => (NotEqual (CMP x y))
(Eq(32|64)F x y) => (FEqual (FCMP(S|D) x y))
(Neq(32|64)F x y) => (FNotEqual (FCMP(S|D) x y))

(Less8 x y) => (LessThan (CMP (SignExt8to64 x) (SignExt8to64 y)))
(Leq8 x y) => (LessEqual (CMP (SignExt8to64 x) (SignExt8to64 y)))
(Less16 x y) => (LessThan (CMP (SignExt16to64 x) (SignExt16to64 y)))
(Leq16 x y) => (LessEqual (CMP (SignExt16to64 x) (SignExt16to64 y)))
(Less32 x y) => (LessThan (CMP (SignExt32to64 x) (SignExt32to64 y)))
(Leq32 x y) => (LessEqual (CMP (SignExt32to64 x) (SignExt32to64 y)))
(Less8U x y) => (LessThanU (CMP (ZeroExt8to64 x) (ZeroExt8to64 y)))
(Leq8U x y) => (LessEqualU (CMP (ZeroExt8to64 x) (ZeroExt8to64 y)))
(Less16U x y) => (LessThanU (CMP (ZeroExt16to64 x) (ZeroExt16to64 y)))
(Leq16U x y) => (LessEqualU (CMP (ZeroExt16to64 x) (ZeroExt16to64 y)))
(Less32U x y) => (LessThanU (CMP (ZeroExt32to64 x) (ZeroExt32to64 y)))
(Leq32U x y) => (LessEqualU (CMP (ZeroExt32to64 x) (ZeroExt32to64 y)))
(Less64 x y) => (LessThan (CMP x y))
(Leq64 x y) => (LessEqual (CMP x y))
(Eq64 x y) => (Equal (CMP x y))
(Neq64 x y) => (NotEqual (CMP x y))
(Less64U x y) => (LessThanU (CMP x y))
(Leq64U x y) => (LessEqualU (CMP x y))
(Less(32|64)F x y) => (FLessThan (FCMP(S|D) x y))
(Leq(32|64)F x y) => (FLessEqual (FCMP(S|D) x y))

// A constant shift count needs no range check: fold it directly, or to
// zero when it is out of range. These must precede the masked forms
// below, which would otherwise emit the guard sequence for a constant.
//
// Values narrower than 64 bits may carry junk in their high bits (a
// 32-bit add can carry into bit 32, a left shift pushes bits past the
// type width), so a right shift must first extend the operand to its
// canonical 64-bit form: zero-extended for logical shifts,
// sign-extended for arithmetic ones. Left shifts need no extension —
// any junk moves further up, away from the bits the type owns.
(Lsh(8|16|32|64)x64 <t> x (Const64 [c])) && uint64(c) < 64 => (SLLDconst <t> [c] x)
(Rsh8Ux64  <t> x (Const64 [c])) && uint64(c) < 64 => (SRLDconst <t> [c] (ZeroExt8to64  x))
(Rsh16Ux64 <t> x (Const64 [c])) && uint64(c) < 64 => (SRLDconst <t> [c] (ZeroExt16to64 x))
(Rsh32Ux64 <t> x (Const64 [c])) && uint64(c) < 64 => (SRLDconst <t> [c] (ZeroExt32to64 x))
(Rsh64Ux64 <t> x (Const64 [c])) && uint64(c) < 64 => (SRLDconst <t> [c] x)
(Rsh8x64  <t> x (Const64 [c])) && uint64(c) < 64 => (SRADconst <t> [c] (SignExt8to64  x))
(Rsh16x64 <t> x (Const64 [c])) && uint64(c) < 64 => (SRADconst <t> [c] (SignExt16to64 x))
(Rsh32x64 <t> x (Const64 [c])) && uint64(c) < 64 => (SRADconst <t> [c] (SignExt32to64 x))
(Rsh64x64 <t> x (Const64 [c])) && uint64(c) < 64 => (SRADconst <t> [c] x)
(Lsh(8|16|32|64)x64 _ (Const64 [c])) && uint64(c) >= 64 => (MOVDconst [0])
(Rsh(8|16|32|64)Ux64 _ (Const64 [c])) && uint64(c) >= 64 => (MOVDconst [0])
(Rsh8x64  <t> x (Const64 [c])) && uint64(c) >= 64 => (SRADconst <t> [63] (SignExt8to64  x))
(Rsh16x64 <t> x (Const64 [c])) && uint64(c) >= 64 => (SRADconst <t> [63] (SignExt16to64 x))
(Rsh32x64 <t> x (Const64 [c])) && uint64(c) >= 64 => (SRADconst <t> [63] (SignExt32to64 x))
(Rsh64x64 <t> x (Const64 [c])) && uint64(c) >= 64 => (SRADconst <t> [63] x)

// Shifts. SPARC masks the shift count to the register width, but Go
// defines a count at or beyond the width as producing zero (or the
// sign, for arithmetic right shifts). The mask below is all-ones when
// the count is in range and zero otherwise. Right-shift operands are
// extended for the same reason as in the constant rules above.
(Lsh8x64 <t> x y) => (AND (NEG <t> (LessThanU <typ.UInt64> (CMPconst <types.TypeFlags> [64] y))) (SLLD <t> x y))
(Rsh8x64 <t> x y) => (SRAD <t> (SignExt8to64 x) (OR <typ.UInt64> (NEG <typ.UInt64> (GreaterThanU <typ.UInt64> (CMPconst <types.TypeFlags> [63] y))) y))
(Rsh8Ux64 <t> x y) => (AND (NEG <t> (LessThanU <typ.UInt64> (CMPconst <types.TypeFlags> [64] y))) (SRLD <t> (ZeroExt8to64 x) y))
(Lsh16x64 <t> x y) => (AND (NEG <t> (LessThanU <typ.UInt64> (CMPconst <types.TypeFlags> [64] y))) (SLLD <t> x y))
(Rsh16x64 <t> x y) => (SRAD <t> (SignExt16to64 x) (OR <typ.UInt64> (NEG <typ.UInt64> (GreaterThanU <typ.UInt64> (CMPconst <types.TypeFlags> [63] y))) y))
(Rsh16Ux64 <t> x y) => (AND (NEG <t> (LessThanU <typ.UInt64> (CMPconst <types.TypeFlags> [64] y))) (SRLD <t> (ZeroExt16to64 x) y))
(Lsh32x64 <t> x y) => (AND (NEG <t> (LessThanU <typ.UInt64> (CMPconst <types.TypeFlags> [64] y))) (SLLD <t> x y))
(Rsh32x64 <t> x y) => (SRAD <t> (SignExt32to64 x) (OR <typ.UInt64> (NEG <typ.UInt64> (GreaterThanU <typ.UInt64> (CMPconst <types.TypeFlags> [63] y))) y))
(Rsh32Ux64 <t> x y) => (AND (NEG <t> (LessThanU <typ.UInt64> (CMPconst <types.TypeFlags> [64] y))) (SRLD <t> (ZeroExt32to64 x) y))
(Lsh64x64 <t> x y) => (AND (NEG <t> (LessThanU <typ.UInt64> (CMPconst <types.TypeFlags> [64] y))) (SLLD <t> x y))
(Rsh64x64 <t> x y) => (SRAD <t> x (OR <typ.UInt64> (NEG <typ.UInt64> (GreaterThanU <typ.UInt64> (CMPconst <types.TypeFlags> [63] y))) y))
(Rsh64Ux64 <t> x y) => (AND (NEG <t> (LessThanU <typ.UInt64> (CMPconst <types.TypeFlags> [64] y))) (SRLD <t> x y))

// Narrower shift counts are zero-extended to 64 bits first.
(Lsh8x8 x y) => (Lsh8x64 x (ZeroExt8to64 y))
(Rsh8x8 x y) => (Rsh8x64 x (ZeroExt8to64 y))
(Rsh8Ux8 x y) => (Rsh8Ux64 x (ZeroExt8to64 y))
(Lsh8x16 x y) => (Lsh8x64 x (ZeroExt16to64 y))
(Rsh8x16 x y) => (Rsh8x64 x (ZeroExt16to64 y))
(Rsh8Ux16 x y) => (Rsh8Ux64 x (ZeroExt16to64 y))
(Lsh8x32 x y) => (Lsh8x64 x (ZeroExt32to64 y))
(Rsh8x32 x y) => (Rsh8x64 x (ZeroExt32to64 y))
(Rsh8Ux32 x y) => (Rsh8Ux64 x (ZeroExt32to64 y))
(Lsh16x8 x y) => (Lsh16x64 x (ZeroExt8to64 y))
(Rsh16x8 x y) => (Rsh16x64 x (ZeroExt8to64 y))
(Rsh16Ux8 x y) => (Rsh16Ux64 x (ZeroExt8to64 y))
(Lsh16x16 x y) => (Lsh16x64 x (ZeroExt16to64 y))
(Rsh16x16 x y) => (Rsh16x64 x (ZeroExt16to64 y))
(Rsh16Ux16 x y) => (Rsh16Ux64 x (ZeroExt16to64 y))
(Lsh16x32 x y) => (Lsh16x64 x (ZeroExt32to64 y))
(Rsh16x32 x y) => (Rsh16x64 x (ZeroExt32to64 y))
(Rsh16Ux32 x y) => (Rsh16Ux64 x (ZeroExt32to64 y))
(Lsh32x8 x y) => (Lsh32x64 x (ZeroExt8to64 y))
(Rsh32x8 x y) => (Rsh32x64 x (ZeroExt8to64 y))
(Rsh32Ux8 x y) => (Rsh32Ux64 x (ZeroExt8to64 y))
(Lsh32x16 x y) => (Lsh32x64 x (ZeroExt16to64 y))
(Rsh32x16 x y) => (Rsh32x64 x (ZeroExt16to64 y))
(Rsh32Ux16 x y) => (Rsh32Ux64 x (ZeroExt16to64 y))
(Lsh32x32 x y) => (Lsh32x64 x (ZeroExt32to64 y))
(Rsh32x32 x y) => (Rsh32x64 x (ZeroExt32to64 y))
(Rsh32Ux32 x y) => (Rsh32Ux64 x (ZeroExt32to64 y))
(Lsh64x8 x y) => (Lsh64x64 x (ZeroExt8to64 y))
(Rsh64x8 x y) => (Rsh64x64 x (ZeroExt8to64 y))
(Rsh64Ux8 x y) => (Rsh64Ux64 x (ZeroExt8to64 y))
(Lsh64x16 x y) => (Lsh64x64 x (ZeroExt16to64 y))
(Rsh64x16 x y) => (Rsh64x64 x (ZeroExt16to64 y))
(Rsh64Ux16 x y) => (Rsh64Ux64 x (ZeroExt16to64 y))
(Lsh64x32 x y) => (Lsh64x64 x (ZeroExt32to64 y))
(Rsh64x32 x y) => (Rsh64x64 x (ZeroExt32to64 y))
(Rsh64Ux32 x y) => (Rsh64Ux64 x (ZeroExt32to64 y))

// Division and remainder. SPARC has no remainder instruction, so the
// modulus is computed as x - (x/y)*y.
(Div8 x y) => (SDIVD (SignExt8to64 <typ.Int64> x) (SignExt8to64 <typ.Int64> y))
(Div8u x y) => (UDIVD (ZeroExt8to64 <typ.UInt64> x) (ZeroExt8to64 <typ.UInt64> y))
(Div16 x y) => (SDIVD (SignExt16to64 <typ.Int64> x) (SignExt16to64 <typ.Int64> y))
(Div16u x y) => (UDIVD (ZeroExt16to64 <typ.UInt64> x) (ZeroExt16to64 <typ.UInt64> y))
(Div32 x y) => (SDIVD (SignExt32to64 <typ.Int64> x) (SignExt32to64 <typ.Int64> y))
(Div32u x y) => (UDIVD (ZeroExt32to64 <typ.UInt64> x) (ZeroExt32to64 <typ.UInt64> y))
(Mod64 x y) => (SUB <typ.Int64> x (MULD <typ.Int64> (SDIVD <typ.Int64> x y) y))
(Mod64u x y) => (SUB <typ.UInt64> x (MULD <typ.UInt64> (UDIVD <typ.UInt64> x y) y))
(Mod8 x y) => (Mod64 (SignExt8to64 <typ.Int64> x) (SignExt8to64 <typ.Int64> y))
(Mod8u x y) => (Mod64u (ZeroExt8to64 <typ.UInt64> x) (ZeroExt8to64 <typ.UInt64> y))
(Mod16 x y) => (Mod64 (SignExt16to64 <typ.Int64> x) (SignExt16to64 <typ.Int64> y))
(Mod16u x y) => (Mod64u (ZeroExt16to64 <typ.UInt64> x) (ZeroExt16to64 <typ.UInt64> y))
(Mod32 x y) => (Mod64 (SignExt32to64 <typ.Int64> x) (SignExt32to64 <typ.Int64> y))
(Mod32u x y) => (Mod64u (ZeroExt32to64 <typ.UInt64> x) (ZeroExt32to64 <typ.UInt64> y))

// High half of a multiply. SPARC V9 has no 64x64->128 multiply, but
// VIS3 adds UMULXHI, which the T4 implements.
(Hmul64u x y) => (UMULXHI x y)
(Hmul64 x y) => (SUB <typ.Int64> (SUB <typ.Int64> (UMULXHI <typ.Int64> x y) (AND <typ.Int64> y (SRADconst <typ.Int64> [63] x))) (AND <typ.Int64> x (SRADconst <typ.Int64> [63] y)))
(Hmul32 x y) => (SRADconst [32] (MULD <typ.Int64> (SignExt32to64 <typ.Int64> x) (SignExt32to64 <typ.Int64> y)))
(Hmul32u x y) => (SRLDconst [32] (MULD <typ.UInt64> (ZeroExt32to64 <typ.UInt64> x) (ZeroExt32to64 <typ.UInt64> y)))
(Avg64u <t> x y) => (ADD (SRLDconst <t> [1] (SUB <t> x y)) y)

// Conversions.
(Cvt32to(32|64)F x) => (FXTO(S|D) (SignExt32to64 <typ.Int64> x))
// Use the 32-bit conversion, not a 64-bit one narrowed afterwards: the
// hardware saturates to the width it converts to, so truncating a
// saturated int64 loses the clamp entirely (+Inf became -1).
(Cvt(32|64)Fto32 x) => (MOVW <typ.Int64> (F(S|D)TOI <typ.Int32> x))
(Round(32|64)F ...) => (Copy ...)
(Sqrt ...) => (FSQRTD ...)
(Sqrt32 ...) => (FSQRTS ...)
(Abs ...) => (FABSD ...)
(CvtBoolToUint8 ...) => (Copy ...)

// Rotates. SPARC V9 has no rotate instruction, so a rotate is a pair
// of shifts ORed together. The shift count is masked to the register
// width by the hardware, which happens to give the right answer for a
// zero rotate: the complementary shift becomes a shift by zero, and
// x|x is x.
(RotateLeft64 <t> x y) => (OR <t> (SLLD <t> x y) (SRLD <t> x (SUB <typ.UInt64> (MOVDconst <typ.UInt64> [64]) y)))
(RotateLeft32 <t> x y) => (OR <t> (SLLW <t> x y) (SRLW <t> x (SUB <typ.UInt64> (MOVDconst <typ.UInt64> [32]) y)))

// canRotate reports false for sparc64, so the idiom recognizer never forms
// an 8- or 16-bit rotate. divisible.rules emits them anyway for constant
// divisibility tests, always with a constant rotate amount, so a
// constant-only decomposition into shifts is enough.
(RotateLeft8  <t> x (MOVDconst [c])) => (Or8  (Lsh8x64  <t> x (MOVDconst [c&7]))  (Rsh8Ux64  <t> x (MOVDconst [-c&7])))
(RotateLeft16 <t> x (MOVDconst [c])) => (Or16 (Lsh16x64 <t> x (MOVDconst [c&15])) (Rsh16Ux64 <t> x (MOVDconst [-c&15])))

// Miscellaneous.
(Not x) => (XORconst <typ.Bool> [1] x)
(Slicemask <t> x) => (SRADconst <t> [63] (NEG <t> x))
// SPARC has no 64x64->128 multiply instruction, so the two halves are
// computed separately and paired; the generic rules then fold the
// Select0/Select1 that consume them.
(Mul64uhilo ...) => (MULDU ...)
(TailCallInter ...) => (CALLtail ...)
